create_clock -name clk -period 10.65 [get_ports clk]
set_clock_uncertainty 0.25 [get_clocks clk]
set_input_delay 2.0 -clock clk [get_ports {reset imem_read_data* dmem_read_data*}]
set_output_delay 2.0 -clock clk [all_outputs]
set_driving_cell -lib_cell sky130_fd_sc_hd__buf_2 -pin X [get_ports {reset imem_read_data* dmem_read_data*}]
set_load 0.030 [all_outputs]
set_max_transition 1.5 [current_design]
set_max_fanout 20 [current_design]